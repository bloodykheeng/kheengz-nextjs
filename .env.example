# The API (kheengz-laravel), up to and including /api (calls add /v1/...). The public base
# serves uploaded photos.
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_API_BASE_URL=

# Laravel Reverb (websockets): same id/key as the API .env; local is localhost / 8080 / http.
NEXT_PUBLIC_REVERB_APP_ID=
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=
NEXT_PUBLIC_REVERB_PORT=
NEXT_PUBLIC_REVERB_SCHEME=

# Public address of this site: share links and Open Graph tags use it.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_NAME=Kheengz

# Firebase web app (Project settings > General > Your apps). Development = kheengz-dev,
# production = kheengz-6f97b; the same project as the API's FIREBASE_* service account.
# VAPID key: Project settings > Cloud Messaging > Web Push certificates > Generate key pair.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPIDKEY=
